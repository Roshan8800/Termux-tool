#!/bin/bash

# Wrapper script for the Termux Cyber Framework to provide a simple, natural language interface.
# This script abstracts away the underlying command structure.

# Get the directory where this script is located to ensure we run poetry from the project root.
SCRIPT_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" &> /dev/null && pwd )"

# Check if poetry is installed
if ! command -v poetry &> /dev/null; then
    echo "Error: poetry is not installed or not in your PATH."
    echo "Please run the first_run_setup.sh script to install dependencies."
    exit 1
fi

# Change to the script's directory to ensure poetry commands work correctly.
cd "$SCRIPT_DIR"

# If there are no arguments, launch the interactive shell.
if [ $# -eq 0 ]; then
    poetry run tcf shell
else
    # If there are arguments, treat them as a single natural language command and run it.
    poetry run tcf run "$*"
fi
